<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="XboxControllerTool"
    Manufacturer="Andries Benade"
    Version="$(Version)"
    UpgradeCode="7E2F3C54-9A1B-4B0E-9E8E-2C1F5B7A4D31"
    Scope="perMachine"
    Compressed="yes">

    <SummaryInformation Description="Xbox controller desktop utility for TV and couch use" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of XboxControllerTool is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(PublishDir)\XboxControllerTool.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Feature Id="Main" Title="XboxControllerTool" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <CustomAction
      Id="RemoveStartupTask"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;XboxControllerTool&quot; /F"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveStartupTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="XboxControllerTool" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="XboxControllerTool" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Guid="B2D4F1A6-3C77-4E52-9F0B-58A6C9E1D742">
        <Shortcut
          Id="StartMenuApplicationShortcut"
          Name="XboxControllerTool"
          Description="Use an Xbox controller as a Windows mouse and keyboard"
          Target="[INSTALLFOLDER]XboxControllerTool.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\XboxControllerTool" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C51A9D30-6B84-42F7-A1E9-0D7C4F2B8E65">
        <Shortcut
          Id="DesktopApplicationShortcut"
          Name="XboxControllerTool"
          Description="Use an Xbox controller as a Windows mouse and keyboard"
          Target="[INSTALLFOLDER]XboxControllerTool.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\XboxControllerTool" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
